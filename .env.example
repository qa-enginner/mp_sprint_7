POSTGRES_DB=auth_db
ETL_POSTGRES_DB=movies
ADMIN_POSTGRES_DB=movies
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_ECHO=false

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

SECRET_KEY=secret_key
ALGORITHM=HS256
AUTH_SERVICE_URL=http://localhost:8000
AUTH_API_LOGIN_URL=http://auth-service:8000/api/v1/auth/login
AUTH_API_REFRESH_URL=http://auth-service:8000/api/v1/auth/refresh


ELASTIC_HOST=elasticsearch
ELASTIC_PORT=9200

BATCH_SIZE=100
SLEEP_INTERVAL=30
MAX_RETRIES=3
STATE_KEY=etl_state


PROJECT_NAME="Movie theater"
PROJECT_DESCRIPTION="The best movie theater for averyone"

DEBUG=True
SECRET_KEY=your-secret-here

SQL_ENGINE=django.db.backends.postgresql_psycopg2

SQL_HOST=postgres
SQL_PORT=5432
SQL_OPTIONS=-c search_path=public,content
DATABASE_TYPE=postgres
ALLOWED_HOSTS=localhost, 127.0.0.1, [::1], admin-panel, admin-panel:8000

YANDEX_CLIENT_ID=your-client-id-here
YANDEX_CLIENT_SECRET=your-client-secret-here
YANDEX_REDIRECT_URI=http://localhost:8002/api/v1/oauth/yandex/callback

JAEGER_AGENT_HOST=jaeger
JAEGER_AGENT_PORT=6831
JAEGER_COLLECTOR_ENDPOINT=http://jaeger:14268/api/traces
ENABLE_TRACING=true

REQUEST_LIMIT_PER_MINUTE=20

# CORS settings
# Environment: development, production, etc.
ENVIRONMENT=development
# Comma-separated list of allowed origins (e.g., "https://example.com,https://app.example.com")
CORS_ALLOWED_ORIGINS=
# Allow all origins (not recommended with credentials)
CORS_ALLOW_ALL_ORIGINS=false
# Comma-separated list of allowed HTTP methods
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
# Comma-separated list of allowed headers
CORS_ALLOW_HEADERS=Content-Type,Authorization,Accept
# Comma-separated list of exposed headers
CORS_EXPOSE_HEADERS=